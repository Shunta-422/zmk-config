#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define NUM 1
#define MOVE 2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // 各行6キー x 5行(row4は親指の段)。左右合わせて60キー。
            // 並び順はsnacky.dtsiのdefault_transformのmapと対応しています。
            //
            // row0は数字ではなく記号(シフト無しで打てる、標準的な数字段の
            // シフト面)に変更。数字自体はnum_layer(&lt NUM SPACE を長押し)
            // で同じ位置から入力する。
            bindings = <
                // row0: 記号列(数字段のシフト面と同じ記号)
                &kp GRAVE &kp EXCL  &kp AT   &kp HASH  &kp DLLR &kp PRCNT                       &kp DEL   &kp CARET   &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR 
                // row1: QWERTY列
                &kp TAB   &kp Q     &kp W    &kp E     &kp R    &kp T                           &kp Y     &kp U      &kp I      &kp O     &kp P     &kp MINUS
                // row2: ホームポジション列
                &kp CAPS  &kp A     &kp S    &kp D     &kp F    &kp G                           &kp H     &kp J      &kp K      &kp L     &kp SEMI  &kp SQT   
                // row3: 下段列
                &kp LSHFT &kp Z     &kp X    &kp C     &kp V    &kp B                           &kp EQUAL &kp N      &kp M     &kp COMMA  &kp DOT   &kp FSLH
                // row4: 親指の段(左6 / 右6)。左手親指にNUMレイヤーとMOVEレイヤーを配置。
                &kp ESC   &kp LCTRL &kp LGUI &mo MOVE  &mo NUM  &kp SPACE                       &kp BSPC  &kp ENTER  &kp LALT  &kp LBKT  &kp RBKT  &kp BSLH
            >;
        };

        num_layer {
            // 右手側に電卓ライクな配置それ以外は&transで下の層を素通しする。
            // 左手側にはBluetooth関連のキーを配置。
            //   row1: 接続先プロファイル0〜4を選択(PCごとに別のプロファイルを使う)
            //   row2: 前/次のプロファイルへ切替、USB/BLE出力の切替
            //   row3: 現在のプロファイルのペアリング情報を削除(新しいPCとペアリングし直す時に使用)
            bindings = <
                // row0: 素通し
                &trans    &trans   &trans    &trans   &trans    &trans                       &trans    &trans    &trans    &trans   &trans      &trans
                // row1-row4: 左手側にBluetooth、右手側に電卓ライクな配置
                &trans    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans    &kp N7    &kp N8    &kp N9   &trans      &kp FSLH
                &trans    &bt BT_PRV &bt BT_NXT &trans &out OUT_USB &out OUT_BLE             &trans    &kp N4    &kp N5    &kp N6   &trans      &kp ASTRK
                &trans    &bt BT_CLR &trans  &trans   &trans    &trans                       &trans    &kp N1    &kp N2    &kp N3   &trans      &kp MINUS
                &trans    &trans   &trans    &trans   &trans    &trans                       &trans    &kp N0    &trans    &kp EQUAL &kp PLUS    &trans
            >;
        };

        move_layer {
            // 移動系統
            bindings = <
                // row0: 素通し
                &trans    &trans   &trans    &trans   &trans    &trans                       &trans    &trans      &trans     &trans     &trans    &trans
                // row1-row3: 右手側に移動系
                &trans    &trans   &trans    &trans   &trans    &trans                       &trans    &kp HOME    &kp UP     &kp END    &trans    &trans
                &trans    &trans   &trans    &trans   &trans    &trans                       &trans    &kp LEFT    &kp DOWN   &kp RIGHT  &trans    &trans
                &trans    &trans   &trans    &trans   &trans    &trans                       &trans    &trans      &trans     &trans     &trans    &trans
                // row4: 素通し(左6 / 右6)
                &trans    &trans   &trans    &trans   &trans    &trans                       &trans    &trans      &trans     &trans     &trans    &trans
            >;
        };
    };
};
