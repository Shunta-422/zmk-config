#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    // 通常のGPIOマトリクス(charlieplexではない)。
    // 応答性・低消費電力の検証の結果、charlieplexの本質的なメリットは
    // 「省ピン化」であって応答性/低電力そのものではないと判明したため、
    // ブレッドボードテストで実際に動作確認済みの col2row マトリクス方式を採用。
    // 片手: 列(col, 出力)6本 + 行(row, 入力/割り込み)5本 = 11本(XIAOの全GPIO)。
    // 6列 x 5行 = 30セルが、11本のGPIOで作れる電気マトリクスの理論上の
    // 最大サイズ(6+5=11という配分が最も効率が良い)。
    //
    // 各行6キー x 5行 = 30キー/片手(row4は親指の段)。
    // 合計: 30 x 2 = 60キー。30セルの電気マトリクスをそのまま使う。
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        // keymapのbindingsと同じく「行ごとに 左手 → 右手」の順で並べる。
        // (bindingsのn番目がこのmapのn番目に対応するため、左手30キー →
        //  右手30キーの順で書くと左右が混ざってしまう)
        // 右手は col-offset = 6 加算後のアドレス。
        // 右手の基板は左手と鏡写しに配線されている(col0が小指側=外側)ため、
        // 右手側は列番号を逆順(内側のcol5=11 → 外側のcol0=6)に並べる。
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                    RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                    RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                    RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                    RC(3,11) RC(3,10) RC(3,9) RC(3,8) RC(3,7) RC(3,6)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)                    RC(4,11) RC(4,10) RC(4,9) RC(4,8) RC(4,7) RC(4,6)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
    };
};
